# Kopieer naar .env (gitignored). Nooit VITE_ voor toegang. Nooit deze file met echte waarden committen.

# --- Verplicht op Vercel (Production + Preview + Development) ---
# Lokaal: printf '%s' 'jouw-code' | node scripts/hash-pin.mjs
# Daarna Redeploy. Geen aanhalingstekens rond de waarde.
SESSION_SECRET=
AUTH_PIN_SALT=
AUTH_PIN_HASH=
AUTH_PEPPER=

# --- Verplicht voor dezelfde ritten op telefoon en computer ---
# Vercel → Storage → Blob → store koppelen aan dit project.
# Dat zet BLOB_READ_WRITE_TOKEN automatisch. Niet in git plakken.
BLOB_READ_WRITE_TOKEN=

# --- Optioneel, komen in de frontend (publiek in JS) ---
# Alleen HTTP-referrer beperken in Google Cloud, nooit de toegangscode.
# Zonder sleutel: OpenStreetMap + OSRM.
VITE_GOOGLE_MAPS_API_KEY=
VITE_OPENROUTE_API_KEY=
# VITE_MAPLIBRE_STYLE_URL=

# Optioneel: losse auth-server. Vite heeft dit niet nodig.
# AUTH_PORT=8787

# GitHub Actions (niet hier, niet in Vercel env):
# GitHub → Settings → Secrets and variables → Actions
#   VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID
# AUTH_* / SESSION_SECRET / BLOB blijven in Vercel, nooit in GitHub.
